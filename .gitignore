*.sw?

# img2threejs working artifacts — reference photos (third-party), captured
# screenshots, evidence JSON/logs, and local pipeline state. Ignore the whole
# directory, then re-admit only the two files that are the actual source of
# truth for regenerating the model: the authored spec and its assessment.
# Everything else here (di.json, analysis.md, gate results, comparison
# sheets, camera-solve output, crops...) is derived working evidence, cheap
# to regenerate by re-running the pipeline against the spec.
.img2threejs/*
!.img2threejs/object-sculpt-spec.json
!.img2threejs/assessment.json
!.img2threejs/cart/object-sculpt-spec.json
!.img2threejs/cart/assessment.json

# Copied here only so the Vite dev server can serve them as texture URLs for
# the review harness — the real copies live in .img2threejs/material-evidence/.
public/material-evidence/

# Local preview/session state from the editor's dev-server integration.
.freebuff/

# Real cover art fetched from SteamGridDB by scripts/fetch-covers.mjs. Kept
# out of git history by default — the community-uploaded art it pulls in is
# not something to ship without a deliberate choice. See src/data/covers.ts.
public/covers/

# Spine and back box-art scans, hand-sourced (no fetch script — see each
# generated manifest's own doc comment) — same opt-in-only reasoning as
# public/covers/ above. See src/data/covers.ts.
public/covers-spine/
public/covers-back/

# Real title-logo graphics fetched from SteamGridDB by scripts/fetch-logos.mjs
# — same reasoning and the same opt-in-only contract as public/covers/ above.
# See src/data/logos.ts.
public/logos/

# API keys for local scripts (e.g. STEAMGRIDDB_KEY for scripts/fetch-covers.mjs).
.env
.env.local
